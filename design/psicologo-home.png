<div class="absolute top-80 -left-20 w-80 h-80 bg-secondary-fixed/30 rounded-full blur-3xl pointer-events-none"></div>
<div class="max-w-7xl mx-auto px-gutter py-space-lg relative z-10 flex flex-col gap-space-lg">
<!-- THERAPIST PROFILE HEADER BANNER -->
<section class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
