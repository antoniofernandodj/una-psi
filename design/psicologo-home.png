<!-- Therapist Identity -->
<div class="flex items-center gap-space-md">
<div class="relative flex-shrink-0">
<img alt="Dra. Camila Vasconcelos" class="w-20 h-20 md:w-24 md:h-24 rounded-full object-cover shadow-sm ring-4 ring-primary-fixed" src="https://lh3.googleusercontent.com/aida/AEtjO1VSNiHEEgFqPq3sjFkqCxCYfr2ibg7VYuhUdS03MB5e9gI9xnmbBPAfy3MdR5oHx6cvCpWQxKQJt5N2x6JNrlrBKGXo81wK9_NoGzT5lvv530HZcMg6jFn9G7vQO_Ce6OpgBwg6oWHFyR_7eCaUrfZeo_643tYHMBS4vLZvlx-GCXm0ILgJbIoQo9bbqm0e39bgEPrmF7-GglNSa5CYCPvQHGA0uFOQXZvIUwMKi342TfjUj-8xWj7KmA"/>
