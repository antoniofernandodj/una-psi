<span class="font-label-sm text-label-sm text-on-surface-variant">Plataforma integrada compatível com Resolução CFP 11/2018</span>
</div>
</div>
<input checked="" class="w-5 h-5 rounded text-primary accent-primary" type="checkbox"/>
</label>
<label class="flex items-center justify-between p-space-sm bg-surface-container-low/40 hover:bg-surface-container-low rounded-xl cursor-pointer transition-colors">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-secondary">apartment</span>
<div class="flex flex-col">
<span class="font-label-md text-label-md font-semibold text-on-surface">Presencial no Consultório</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Av. Paulista, Bela Vista, São Paulo - SP</span>
</div>
</div>
