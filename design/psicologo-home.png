<div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col gap-space-md">
<div class="flex items-center justify-between">
<h2 class="font-title-md text-title-md font-bold text-on-surface flex items-center gap-2">
<span class="material-symbols-outlined text-primary">photo_camera</span>
                Identificação Visual
              </h2>
<span class="inline-flex items-center gap-1 bg-tertiary-fixed/30 text-on-tertiary-fixed-variant px-2.5 py-0.5 rounded-full font-label-sm text-label-sm font-semibold">
<span class="material-symbols-outlined text-sm">verified</span>
                Aprovada na moderação
              </span>
</div>
<!-- Profile Avatar with Floating Edit Button -->
<div class="flex flex-col sm:flex-row items-center gap-space-md py-space-xs">
<div class="relative">
